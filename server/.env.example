PORT=5000
MONGODB_URI=mongodb://localhost:27017/saarthiai
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Admin dashboard origin for CORS (required in production). Local dev also allows localhost:3000.
CLIENT_URL=http://localhost:3000

# Google OAuth (same Client ID as the Next.js app — Web application type)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Required for Knowledge Base ingestion
GEMINI_API_KEY=your-gemini-api-key
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=saarthiai

# Optional — RAG tuning (threshold is code constant THRESHOLD=0.3)
RAG_TOP_K=5
UPLOAD_DIR=uploads
ANTHROPIC_API_KEY=
