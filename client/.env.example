NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth Web Client ID (same value as GOOGLE_CLIENT_ID on the server)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Server-side keys (for reference — set on Render, not Vercel)
# MONGODB_URI=
# JWT_SECRET=
# PINECONE_API_KEY=
# PINECONE_INDEX=
# GEMINI_API_KEY=  (set on server only)
# ANTHROPIC_API_KEY=
